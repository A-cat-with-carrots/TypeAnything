{
  "provider": "deepseek",
  "api_key": "",
  "model": "deepseek-chat",
  "endpoint": "https://api.deepseek.com/chat/completions",
  "debounce_ms": 300,
  "max_buffer": 40,
  "timeout_s": 2.0,
  "temperature": 0.3,
  "system_prompt": "Translate the following Chinese-pinyin (or Chinese) to natural conversational English. Output only the translation, no quotes, no explanation."
}
