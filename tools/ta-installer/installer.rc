// TypeAnything Installer — embedded resources.
//
// Integer IDs (see resource.h) — works around string-name FindResource issues.
// Paths absolute because rc.exe is invoked from the .xmake build directory.

#include "resource.h"

// UAC + DPI + UTF-8 manifest
1 24 "D:\\hrdai\\aiForType\\tools\\ta-installer\\manifest.xml"

// Window / taskbar icon
1 ICON "D:\\hrdai\\aiForType\\tools\\ta-settings\\fish.ico"

// ───── Bundled binaries ─────────────────────────────────────────
IDR_RIME_DLL        RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\rime.dll"
IDR_WEASELX64_DLL   RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\weaselx64.dll"
IDR_WEASELSERVER    RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\WeaselServer.exe"
IDR_WEASELDEPLOYER  RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\WeaselDeployer.exe"
IDR_TA_SETTINGS     RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\ta-settings.exe"
IDR_WV2_LOADER      RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\WebView2Loader.dll"

// ───── ta-settings UI (gets copied to <install_dir>\ui\) ────────
IDR_TARGET_UI_HTML  RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\target-ui\\index.html"
IDR_TARGET_UI_CSS   RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\target-ui\\style.css"
IDR_TARGET_UI_JS    RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\target-ui\\app.js"
IDR_TARGET_UI_PNG   RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\target-ui\\fish.png"

// ───── Schema yaml ──────────────────────────────────────────────
IDR_SCHEMA_YAML     RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\typeanything.schema.yaml"

// ───── Installer's own UI ───────────────────────────────────────
IDR_INSTALL_HTML    RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\install-ui\\index.html"
IDR_INSTALL_CSS     RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\install-ui\\style.css"
IDR_INSTALL_JS      RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\install-ui\\app.js"
IDR_INSTALL_PNG     RCDATA "D:\\hrdai\\aiForType\\tools\\ta-installer\\embed\\install-ui\\fish.png"
