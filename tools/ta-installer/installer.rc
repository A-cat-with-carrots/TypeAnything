// TypeAnything Installer — embedded resources.
//
// Integer IDs (see resource.h) — works around string-name FindResource issues.
// Paths absolute because rc.exe is invoked from the .xmake build directory.

#include "resource.h"

// UAC + DPI + UTF-8 manifest
1 24 "D:\\hrdai\\products\\TypeAnything\\tools\\ta-installer\\manifest.xml"

// Window / taskbar icon
1 ICON "D:\\hrdai\\products\\TypeAnything\\tools\\ta-settings\\fish.ico"

// ───── Bundled binaries ─────────────────────────────────────────
IDR_RIME_DLL        RCDATA "D:\\hrdai\\products\\TypeAnything\\tools\\ta-installer\\embed\\rime.dll"
